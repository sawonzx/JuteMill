{
  "name": "jute-mill-erp-demo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "db:provision": "node server/scripts/provision-databases.js",
    "db:seed:nodes": "node server/scripts/seed-all-nodes.js && node server/scripts/isolate-factory-databases.js",
    "db:generate": "npm --workspace server run db:generate",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:seed:reset": "npm --workspace server run db:seed:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10"
  }
}