# Primary connection (defaults to Main Office database)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jute_mill_main?schema=public"

# Multi-Database Branch URLs
DATABASE_URL_MAIN="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jute_mill_main?schema=public"
DATABASE_URL_FAC_A="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jute_mill_fac_a?schema=public"
DATABASE_URL_FAC_B="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jute_mill_fac_b?schema=public"

# Default Server Port & Client Origin
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DEMO_IMPERSONATION_ENABLED=true

# Secrets
JWT_SECRET=your-jwt-secret-key-here
COOKIE_SECRET=your-cookie-secret-key-here
