generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HEAD_OFFICE_ADMIN
  FACTORY_MANAGER
  ACCOUNTANT
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_BANKING
  CHEQUE
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Factory {
  id         String                    @id @default(cuid())
  code       String                    @unique
  name       String
  location   String
  address    String
  createdAt  DateTime                  @default(now())
  users      User[]
  customers  Customer[]
  warehouses Warehouse[]
  inventory  InventoryBalance[]
  thresholds FactoryProductThreshold[]
  movements  InventoryMovement[]
  orders     SalesOrder[]
  invoices   Invoice[]
  production ProductionRecord[]
}

model User {
  id        String              @id @default(cuid())
  name      String
  email     String              @unique
  role      UserRole
  factoryId String?
  factory   Factory?            @relation(fields: [factoryId], references: [id])
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  movements InventoryMovement[]
}

model Customer {
  id            String       @id @default(cuid())
  factoryId     String
  factory       Factory      @relation(fields: [factoryId], references: [id])
  name          String
  code          String
  contactPerson String
  type          CustomerType @default(BUSINESS)
  status        RecordStatus @default(ACTIVE)
  email         String?
  phone         String
  address       String
  city          String
  notes         String?
  orders        SalesOrder[]
  invoices      Invoice[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([factoryId, code])
  @@index([factoryId, name])
  @@index([factoryId, status])
}

model Product {
  id            String                    @id @default(cuid())
  sku           String                    @unique
  name          String
  category      String
  type          ProductType               @default(FINISHED_PRODUCT)
  unit          String                    @default("MT")
  description   String?
  status        RecordStatus              @default(ACTIVE)
  standardPrice Decimal?                  @db.Decimal(12, 2)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  inventory     InventoryBalance[]
  thresholds    FactoryProductThreshold[]
  movements     InventoryMovement[]
  orderLines    SalesOrderLine[]
  production    ProductionRecord[]

  @@index([status, type, category])
  @@index([name])
}

model Warehouse {
  id        String              @id @default(cuid())
  factoryId String
  factory   Factory             @relation(fields: [factoryId], references: [id])
  code      String
  name      String
  isDefault Boolean             @default(false)
  createdAt DateTime            @default(now())
  inventory InventoryBalance[]
  movements InventoryMovement[]

  @@unique([factoryId, code])
  @@unique([id, factoryId])
}

model InventoryBalance {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Factory   @relation(fields: [factoryId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId, factoryId], references: [id, factoryId])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([factoryId, productId])
  @@map("Inventory")
}

model FactoryProductThreshold {
  id              String   @id @default(cuid())
  factoryId       String
  factory         Factory  @relation(fields: [factoryId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  minimumQuantity Decimal  @db.Decimal(14, 3)
  updatedAt       DateTime @updatedAt

  @@unique([factoryId, productId])
}

model InventoryMovement {
  id                String                @id @default(cuid())
  idempotencyKey    String                @unique
  requestHash       String
  factoryId         String
  factory           Factory               @relation(fields: [factoryId], references: [id])
  warehouseId       String
  warehouse         Warehouse             @relation(fields: [warehouseId, factoryId], references: [id, factoryId])
  productId         String
  product           Product               @relation(fields: [productId], references: [id])
  type              InventoryMovementType
  quantity          Decimal               @db.Decimal(14, 3)
  previousQuantity  Decimal               @db.Decimal(14, 3)
  resultingQuantity Decimal               @db.Decimal(14, 3)
  reason            String?
  reference         String?
  remarks           String?
  createdById       String
  createdBy         User                  @relation(fields: [createdById], references: [id])
  transactionDate   DateTime              @default(now())
  createdAt         DateTime              @default(now())

  @@index([factoryId, transactionDate])
  @@index([productId, transactionDate])
  @@index([warehouseId, transactionDate])
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  factoryId   String
  factory     Factory          @relation(fields: [factoryId], references: [id])
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  status      OrderStatus      @default(DRAFT)
  orderDate   DateTime         @default(now())
  dueDate     DateTime
  total       Decimal          @db.Decimal(14, 2)
  lines       SalesOrderLine[]
  invoice     Invoice?
}

model SalesOrderLine {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Decimal    @db.Decimal(12, 2)
  unitPrice Decimal    @db.Decimal(12, 2)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  factoryId     String
  factory       Factory       @relation(fields: [factoryId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?       @unique
  order         SalesOrder?   @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  total         Decimal       @db.Decimal(14, 2)
  payments      Payment[]
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
}

model ProductionRecord {
  id              String           @id @default(cuid())
  batchNumber     String           @unique
  factoryId       String
  factory         Factory          @relation(fields: [factoryId], references: [id])
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  status          ProductionStatus @default(PLANNED)
  plannedQuantity Decimal          @db.Decimal(12, 2)
  actualQuantity  Decimal?         @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
}
