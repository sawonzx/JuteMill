generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HEAD_OFFICE_ADMIN
  FACTORY_MANAGER
  ACCOUNTANT
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  FULFILLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_BANKING
  CHEQUE
  OTHER
}

enum ProductionStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Company {
  id        String   @id @default(cuid())
  name      String   @default("Bengal Jute Industries Ltd.")
  code      String   @default("BJIL")
  currency  String   @default("BDT")
  email     String   @default("info@bengaljute.demo")
  phone     String   @default("+880 2-9887766")
  address   String   @default("Bengal House, 45 Dilkusha C/A, Dhaka, Bangladesh")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Factory {
  id          String                    @id @default(cuid())
  code        String                    @unique
  name        String
  location    String
  address     String
  phone       String?
  email       String?
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  users       User[]
  assignments UserFactoryAssignment[]
  customers   Customer[]
  warehouses  Warehouse[]
  inventory   InventoryBalance[]
  thresholds  FactoryProductThreshold[]
  movements   InventoryMovement[]
  orders      SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  production  ProductionRecord[]
  auditLogs   AuditLog[]
}

model User {
  id           String                  @id @default(cuid())
  name         String
  email        String                  @unique
  passwordHash String?
  role         UserRole
  permissions  String[]                @default([])
  factoryId    String?
  factory      Factory?                @relation(fields: [factoryId], references: [id])
  assignments  UserFactoryAssignment[]
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  movements    InventoryMovement[]
  auditLogs    AuditLog[]
  orders       SalesOrder[]
  payments     Payment[]
  production   ProductionRecord[]
}

model UserFactoryAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryId String
  factory   Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, factoryId])
}

model Customer {
  id            String       @id @default(cuid())
  factoryId     String
  factory       Factory      @relation(fields: [factoryId], references: [id])
  name          String
  code          String
  contactPerson String
  type          CustomerType @default(BUSINESS)
  status        RecordStatus @default(ACTIVE)
  email         String?
  phone         String
  address       String
  city          String
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        SalesOrder[]
  invoices      Invoice[]
  payments      Payment[]

  @@unique([factoryId, code])
  @@index([factoryId, name])
  @@index([factoryId, status])
}

model Product {
  id               String                    @id @default(cuid())
  sku              String                    @unique
  name             String
  category         String
  type             ProductType               @default(FINISHED_PRODUCT)
  unit             String                    @default("MT")
  description      String?
  status           RecordStatus              @default(ACTIVE)
  standardPrice    Decimal?                  @db.Decimal(12, 2)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  inventory        InventoryBalance[]
  thresholds       FactoryProductThreshold[]
  movements        InventoryMovement[]
  orderLines       SalesOrderLine[]
  invoiceItems     InvoiceItem[]
  rawProductions   ProductionRecord[]        @relation("RawMaterialInputs")
  yieldProductions ProductionRecord[]        @relation("FinishedOutputs")

  @@index([status, type, category])
  @@index([name])
}

model Warehouse {
  id        String              @id @default(cuid())
  factoryId String
  factory   Factory             @relation(fields: [factoryId], references: [id])
  code      String
  name      String
  isDefault Boolean             @default(false)
  createdAt DateTime            @default(now())
  inventory InventoryBalance[]
  movements InventoryMovement[]

  @@unique([factoryId, code])
  @@unique([id, factoryId])
}

model InventoryBalance {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Factory   @relation(fields: [factoryId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId, factoryId], references: [id, factoryId])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([factoryId, productId])
  @@map("Inventory")
}

model FactoryProductThreshold {
  id              String   @id @default(cuid())
  factoryId       String
  factory         Factory  @relation(fields: [factoryId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  minimumQuantity Decimal  @db.Decimal(14, 3)
  updatedAt       DateTime @updatedAt

  @@unique([factoryId, productId])
}

model InventoryMovement {
  id                String                @id @default(cuid())
  idempotencyKey    String                @unique
  requestHash       String
  factoryId         String
  factory           Factory               @relation(fields: [factoryId], references: [id])
  warehouseId       String
  warehouse         Warehouse             @relation(fields: [warehouseId, factoryId], references: [id, factoryId])
  productId         String
  product           Product               @relation(fields: [productId], references: [id])
  type              InventoryMovementType
  quantity          Decimal               @db.Decimal(14, 3)
  previousQuantity  Decimal               @db.Decimal(14, 3)
  resultingQuantity Decimal               @db.Decimal(14, 3)
  reason            String?
  reference         String?
  remarks           String?
  createdById       String?
  createdBy         User?                 @relation(fields: [createdById], references: [id])
  transactionDate   DateTime              @default(now())
  createdAt         DateTime              @default(now())

  @@index([factoryId, transactionDate])
  @@index([productId, transactionDate])
  @@index([warehouseId, transactionDate])
}

model SalesOrder {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  factoryId       String
  factory         Factory          @relation(fields: [factoryId], references: [id])
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          OrderStatus      @default(DRAFT)
  orderDate       DateTime         @default(now())
  dueDate         DateTime
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  taxRate         Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  deliveryAddress String?
  notes           String?
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id])
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           SalesOrderLine[]
  invoice         Invoice?

  @@index([factoryId, status])
  @@index([customerId, orderDate])
}

model SalesOrderLine {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Decimal    @db.Decimal(12, 2)
  unitPrice Decimal    @db.Decimal(12, 2)
  subtotal  Decimal    @default(0) @db.Decimal(14, 2)

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  factoryId     String
  factory       Factory       @relation(fields: [factoryId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?       @unique
  order         SalesOrder?   @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal       @default(0) @db.Decimal(14, 2)
  notes         String?
  terms         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  payments      Payment[]

  @@index([factoryId, status])
  @@index([customerId, issueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  receiptNo   String        @unique
  factoryId   String
  factory     Factory       @relation(fields: [factoryId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  paidAt      DateTime      @default(now())
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([factoryId, paidAt])
  @@index([customerId, paidAt])
  @@index([invoiceId])
}

model ProductionRecord {
  id                  String           @id @default(cuid())
  batchNumber         String           @unique
  factoryId           String
  factory             Factory          @relation(fields: [factoryId], references: [id])
  rawMaterialId       String
  rawMaterial         Product          @relation("RawMaterialInputs", fields: [rawMaterialId], references: [id])
  rawMaterialQuantity Decimal          @db.Decimal(14, 3)
  finishedProductId   String
  finishedProduct     Product          @relation("FinishedOutputs", fields: [finishedProductId], references: [id])
  finishedQuantity    Decimal          @db.Decimal(14, 3)
  wastageQuantity     Decimal?         @default(0) @db.Decimal(14, 3)
  status              ProductionStatus @default(DRAFT)
  productionDate      DateTime         @default(now())
  completedAt         DateTime?
  remarks             String?
  createdById         String?
  createdBy           User?            @relation(fields: [createdById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([factoryId, productionDate])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  factoryId String?
  factory   Factory? @relation(fields: [factoryId], references: [id])
  createdAt DateTime @default(now())

  @@index([factoryId, createdAt])
  @@index([entity, entityId])
}

model TrashItem {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  title       String
  subTitle    String?
  factoryId   String?
  data        Json
  deletedById String?
  deletedAt   DateTime @default(now())

  @@index([entityType])
  @@index([factoryId])
  @@index([deletedAt])
}
